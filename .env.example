# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env（.env 已被 git 忽略）

# 首次启动时创建的管理员。密码至少 8 位、同时含字母和数字、不含用户名。
# 留空则生成随机临时密码打印在后端日志里（docker compose logs backend），首次登录强制修改。
THREADSCOPE_ADMIN_USERNAME=admin
THREADSCOPE_ADMIN_PASSWORD=

# 忘记管理员密码：设为 true 并填好上面的密码，docker compose up -d 重启后端即重置；用完改回 false
THREADSCOPE_RESET_ADMIN_PASSWORD=false

# 无操作多久后需要重新登录
THREADSCOPE_SESSION_TIMEOUT=8h

# 以后启用 HTTPS 后改为 true，会话 cookie 只走加密连接
THREADSCOPE_COOKIE_SECURE=false

# 数据库密码，只在第一次创建数据卷时生效
POSTGRES_PASSWORD=threadscope

# 国内服务器构建前端镜像可用镜像源
# NPM_REGISTRY=https://registry.npmmirror.com
